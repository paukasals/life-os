# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (via Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+1...

# Business
BUSINESS_NAME=Lobsteria & The Crepes & Waffles Bar
TIMEZONE=America/New_York

# Marketing
GOOGLE_ADS_API_KEY=
META_ACCESS_TOKEN=

# Creative Studio (video/photo content pipeline)
GEMINI_API_KEY=
# Optional, all no-ops if unset — see creative-studio/README.md
CREATIVE_STUDIO_MUSIC_PATH=
# The Bevan brand font (creative-studio/fonts/Bevan-Regular.ttf) is used
# by default — only set this to override it with a different font, or to
# "none" to disable it and use the plain system font instead.
CREATIVE_STUDIO_FONT_PATH=
# The Lobsteria warm LUT (creative-studio/luts/lobsteria-warm.cube) is
# used by default — only set this to override it with a different LUT,
# or to "none" to disable LUT grading and use the plain preset instead.
CREATIVE_STUDIO_LUT_PATH=

# Cloudflare R2 (public hosting for finished Creative Studio videos, so
# Buffer's API can fetch them by URL — see creative-studio/README.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# Finance
STRIPE_SECRET_KEY=
BANK_API_KEY=

# Inventory
INVENTORY_WEBHOOK_URL=

# Reviews
GOOGLE_PLACES_API_KEY=
TRUSTPILOT_API_KEY=

# Health
APPLE_HEALTH_API_KEY=
APPLE_HEALTH_EXPORT_PATH=

# Calendar (Get from Google Cloud Console)
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
