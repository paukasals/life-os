# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (via Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+1...

# Business
BUSINESS_NAME=Lobsteria & The Crepes & Waffles Bar
TIMEZONE=America/New_York

# Marketing — autopilot safety switch (dry-run | live). Global default plus
# optional per-channel overrides. Everything starts in dry-run: agents draft
# replies/captions/pause decisions and notify Telegram, but never act live,
# until you flip the relevant switch below.
MARKETING_AUTOPILOT=dry-run
MARKETING_AUTOPILOT_REVIEWS=
MARKETING_AUTOPILOT_SOCIAL=
MARKETING_AUTOPILOT_ADS=

# Marketing — Google Business Profile (review responder)
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=accounts/116034753039907650025
GBP_LOCATION_ID=locations/597904207241812621

# Marketing — TikTok Content Posting API (content calendar agent)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Marketing — Meta Ads (ads manager agent)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Marketing — Google Ads (ads manager agent)
GOOGLE_ADS_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Marketing — ad spend guardrails (ads manager only ever auto-pauses, never
# auto-scales budget up). Leave AD_MAX_CAC blank to disable auto-pause.
AD_MAX_CAC=

# Finance
STRIPE_SECRET_KEY=
BANK_API_KEY=

# Inventory
INVENTORY_WEBHOOK_URL=

# Reviews
GOOGLE_PLACES_API_KEY=
TRUSTPILOT_API_KEY=

# Health
APPLE_HEALTH_API_KEY=
APPLE_HEALTH_EXPORT_PATH=

# Calendar (Get from Google Cloud Console)
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
